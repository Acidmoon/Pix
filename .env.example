# Pix 额度/余额查询配置（复制为 .env 后按需修改；.env 不入库）
# 每个厂商一组 QUOTA_<STEM>_* 变量。代码内置同样的默认值，不配置也能跑。
# 新增厂商：在 .env 加一组配置，并在 lib/provider-quotas.ts 的 ADAPTERS 注册适配器。

# ---- DeepSeek ----
QUOTA_DEEPSEEK_NAME=DeepSeek
QUOTA_DEEPSEEK_URL=https://api.deepseek.com/user/balance
QUOTA_DEEPSEEK_KEY_PROVIDERS=deepseek

# ---- MiniMax（国内/国际双区，取第一个有 key 的区） ----
QUOTA_MINIMAX_NAME=MiniMax Token Plan
QUOTA_MINIMAX_CN_URL=https://api.minimaxi.com/v1/api/openplatform/coding_plan/remains
QUOTA_MINIMAX_URL=https://api.minimax.io/v1/api/openplatform/coding_plan/remains
QUOTA_MINIMAX_KEY_PROVIDERS=minimax-cn,minimax

# ---- Kimi（本地 refresh_token 文件，刷新后自动轮换写回） ----
# TOKEN_FILE 指向保存 refresh_token 的文件；失效后需从 www.kimi.com 的
# localStorage 重新取一份写入（localStorage.getItem('refresh_token')）
QUOTA_KIMI_NAME=Kimi
QUOTA_KIMI_REFRESH_URL=https://www.kimi.com/api/auth/token/refresh
QUOTA_KIMI_STATS_URL=https://www.kimi.com/apiv2/kimi.gateway.membership.v2.MembershipService/GetSubscriptionStats
QUOTA_KIMI_TOKEN_FILE=
