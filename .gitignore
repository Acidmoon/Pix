# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory

# .NET launcher build output
launcher/bin/
launcher/obj/

# Local installed runtime (kept beside the repository on request)
/PixApp/
/logs/
/.build-home/

# voice model files (large binaries)
/models/

# local env overrides (only .env.example is committed)
.env
.env.local
.env.*.local

# pi agent local data / plans
/.pi/

# release staging artifacts and packaged archives
/.tmp-release-pkg/
/Pix-*.zip
